{
  "name": "longbridge-docs",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:hk": "cd apps/hk && bun run dev",
    "dev:sg": "cd apps/sg && bun run dev",
    "dev:us": "cd apps/us && bun run dev",
    "build:hk": "cd apps/hk && bun run build",
    "build:sg": "cd apps/sg && bun run build",
    "build:us": "cd apps/us && bun run build",
    "build": "bun run build:hk && bun run build:sg && bun run build:us",
    "sync:us": "cd apps/us && bun run sync"
  }
}
