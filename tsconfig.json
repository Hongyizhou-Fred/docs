{
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "strict": false,
    "jsx": "preserve",
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    "packages/shared/src/**/*",
    "apps/*/docs/.vitepress/**/*",
    "apps/us/scripts/**/*"
  ]
}
